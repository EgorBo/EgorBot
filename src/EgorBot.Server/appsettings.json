{
  "ConnectionStrings": {
    "Default": "Data Source=egorbot.db"
  },
  "EgorBot": {
    "MaxConcurrentJobs": 6,
    "DefaultCores": 8,
    "JobTimeoutMinutes": 120,
    "ServiceBaseUrl": "http://localhost:5000"
  },
  "Telegram": {
    "BotToken": "",
    "AdminChatId": "",
    "CustomCommands": {}
  },
  "Azure": {
    "AdminPassword": "",
    "MaxConcurrentVMs": 5
  },
  "Aws": {
    "AccessKey": "",
    "SecretKey": "",
    "SshKeyPath": "",
    "Region": "",
    "SecurityGroupId": "",
    "SubnetId": "",
    "KeyPairName": ""
  },
  "Docker": {
    "Image": "ubuntu:24.04",
    "MemoryLimitMb": 16384,
    "CpuLimit": 8,
    "DiskSizeGb": 64
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  }
}
